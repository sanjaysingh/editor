{
  "name": "Offline Code Editor + Live Share",
  "install": "npm install",
  "terminals": [
    {
      "name": "client",
      "command": "npx http-server client -p 8080 -c-1 -a 127.0.0.1"
    },
    {
      "name": "worker",
      "command": "cd server && npx wrangler dev --ip 127.0.0.1 --port 8787"
    }
  ],
  "ports": [
    { "name": "client", "port": 8080 },
    { "name": "worker", "port": 8787 }
  ]
}
